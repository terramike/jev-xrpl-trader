# Paper mode only. Defaults to the established Testnet source; Mainnet requires explicit CLI selection and its own DATA_DIR.
MODE=paper
NETWORK=testnet
SOURCE=testnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
# Optional Mainnet read-only endpoint (used only with --network mainnet --source mainnet).
XRPL_MAINNET_WS_URL=wss://xrplcluster.com/

# Exact market identity. XRP is native and must not have an issuer.
BASE_CURRENCY=XRP
# BASE_ISSUER=
QUOTE_CURRENCY=524C555344000000000000000000000000000000
QUOTE_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV

# mock is a deterministic local assessment; jev uses the configured TypeSafe AI provider.
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
JEV_TIMEOUT_MS=1500
JEV_USD_PER_MILLION_TOKENS=0.042
# Explicit modeled conversion for net quote-currency P&L (example assumption: 1 RLUSD = 1 USD).
USD_TO_QUOTE_RATE=1

# Paper assumptions and independent virtual risk limits.
SPREAD_BPS=30
QUOTE_SIZE=5
MAX_INVENTORY=50
MAX_DAILY_LOSS=25
QUEUE_AHEAD_BASE=5
QUEUE_AHEAD_FRACTION=0.5
MODELED_XRPL_FEE_DROPS=10

DATA_DIR=data
CHECKPOINT_EVERY_LEDGERS=20
PORT=3000
ADMIN_PORT=3001
